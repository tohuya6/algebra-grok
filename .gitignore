# Repo-root ignores. Per-subproject rules live in icl/.gitignore and algebra/.gitignore.
# NOTE: intentionally no bare `env/` here — that would wrongly ignore algebra/env/.
.DS_Store
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# Downloaded model weights (large). Also covered by algebra/.gitignore's /outputs.
algebra/outputs/
